# Copy to .env and fill in. Never commit .env.

# --- Strava (create an app at https://www.strava.com/settings/api) ---
# Set the app's "Authorization Callback Domain" to localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/auth/strava/callback

# --- Garmin Connect ---
# Easiest: run `python -m app.cli garmin-login` once; it saves tokens to GARMIN_TOKEN_DIR
# and handles MFA. Email/password here are only used as a fallback.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_DIR=./data/garmin_tokens

# --- App ---
DATABASE_PATH=./data/fitness.db
# Days of history to pull on the first sync
INITIAL_SYNC_DAYS=120
# Sync automatically every N hours while the server runs (0 = off)
AUTO_SYNC_HOURS=6
